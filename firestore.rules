rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- HELPER FUNCTIONS ----
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Rules can't import files, so this list is a copy of functions/src/admin-emails.json.
    // scripts/test-admin-emails.ts fails if the two differ.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'maryke@travellingsouthafrica.co.za',
          'charles@travellingsouthafrica.co.za'
        ]
      );
    }

    // Rating fields on a listing are written only by the Cloud Function (Admin SDK).
    function ratingFields() {
      return ['ratingAverage', 'ratingCount', 'ratingBreakdown'];
    }

    function createsNoRatingFields() {
      return !request.resource.data.keys().hasAny(ratingFields());
    }

    function keepsRatingFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(ratingFields());
    }

    // 1. Provinces - public read, admin write
    match /provinces/{provinceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Towns - public read, admin write
    match /towns/{townId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Sights - public read, admin write
    match /sights/{sightId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Routes - public read, admin write
    match /routes/{routeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4b. Route Highlight Links - public read, admin write
    match /routeHighlightLinks/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Listings - approved listings are public read, logged-in users can create (status auto-sets to pending), admin can approve/reject.
    // Fields: category (accommodation/restaurant/attraction/service_provider), name, description, town, province, address, phone, website, images array, coverImage, status, submittedBy, submittedAt, approvedBy, approvedAt, expiresAt
    match /listings/{listingId} {
      // Approved listings are public read, admins can read all, owners can read their own submissions
      allow read: if isAdmin() 
        || (resource.data.status == 'approved')
        || (isSignedIn() && resource.data.submittedBy == request.auth.uid);

      // Logged-in users can create. Status must be pending, submittedBy must be themselves, category must be valid.
      allow create: if isSignedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.category in ['accommodation', 'restaurant', 'attraction', 'service_provider'];

      // Admin can update/delete (approve/reject). 
      // Also allow owner to update their own listing if it's still pending and they don't change crucial fields like status or submittedBy
      allow update: if isAdmin() 
        || (
          isSignedIn() 
          && resource.data.submittedBy == request.auth.uid
          && request.resource.data.submittedBy == resource.data.submittedBy
          && request.resource.data.status == 'pending'
        );

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.submittedBy == request.auth.uid);
    }

     // 6. Users - user can read/write own document only
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      match /trips/{tripId} {
        allow read, write: if isOwner(userId);
      }
    }
    

    // 7. Trips - logged-in owner only can read/write
    match /trips/{tripId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 8. Contact Messages - anyone can create, admin read only
    match /contactMessages/{messageId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // 8b. Mail (Trigger Email extension) - anyone can create, admin read/manage
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 9. Payments - admin read, owner can read own
    match /payments/{paymentId} {
      // Admin read, owner can read own (checking userId or submittedBy)
      allow read: if isAdmin() 
        || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.submittedBy == request.auth.uid));
      
      // Allow creation by the owner if they match the userId field, or by admin
      allow create: if isAdmin() 
        || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      
      allow update, delete: if isAdmin();
    }

    // 10. Blog Posts - public read for published, admin read for drafts, admin write.
    // Public queries must filter on published == true, or they are rejected outright.
    match /blogPosts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 11. Events - public read, admin write
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 12. Reviews - one per user per listing (doc ID is `${listingId}_${uid}`). Public once approved.
    // Fields and limits mirror src/lib/reviews.ts.
    function isReviewer() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function hasValidReviewContent(data) {
      return data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.title is string && data.title.trim().size() >= 3 && data.title.trim().size() <= 80
        && data.body is string && data.body.trim().size() >= 20 && data.body.trim().size() <= 2000
        && (!('visitDate' in data) || (data.visitDate is string && data.visitDate.matches('[0-9]{4}-(0[1-9]|1[0-2])')));
    }

    function reviewListingPath(data) {
      let collectionName = {
        'accommodation': 'accommodations',
        'service_provider': 'service_providers',
        'restaurant': 'restaurants',
        'attraction': 'attractions'
      }[data.listingType];
      return /databases/$(database)/documents/$(collectionName)/$(data.listingId);
    }

    // The listing must be published and not the reviewer's own, and the stored title must be its real name.
    function canReviewListing(data) {
      let listing = get(reviewListingPath(data)).data;
      return listing.get('approved', false) == true
        && listing.get('name', '') == data.listingTitle
        && listing.get('submittedBy', '') != request.auth.uid
        && listing.get('ownerUid', '') != request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved'
        || isOwner(resource.data.userId)
        || isAdmin();

      allow create: if isReviewer()
        && request.resource.data.keys().hasAll(['listingId', 'listingType', 'listingTitle', 'userId', 'userName', 'rating', 'title', 'body', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['listingId', 'listingType', 'listingTitle', 'userId', 'userName', 'rating', 'title', 'body', 'visitDate', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.listingId is string
        && reviewId == request.resource.data.listingId + '_' + request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.listingType in ['accommodation', 'service_provider', 'restaurant', 'attraction']
        && request.resource.data.userName is string
        && request.resource.data.userName.size() >= 1 && request.resource.data.userName.size() <= 60
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && hasValidReviewContent(request.resource.data)
        && canReviewListing(request.resource.data);

      // Authors may rewrite their review, which always sends it back to pending. Admins may only moderate.
      allow update: if (
          isReviewer()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'title', 'body', 'visitDate', 'status', 'updatedAt'])
          && request.resource.data.status == 'pending'
          && request.resource.data.updatedAt == request.time
          && hasValidReviewContent(request.resource.data)
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'moderatedAt', 'moderatedBy'])
          && request.resource.data.status in ['pending', 'approved', 'rejected']
          && request.resource.data.moderatedAt == request.time
          && request.resource.data.moderatedBy == request.auth.uid
        );

      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ---- LEGACY COLLECTIONS (For backward compatibility, public read / admin write) ----
    match /accommodations/{docId} {
      allow read: if true;
      allow create: if isAdmin() && createsNoRatingFields();
      allow update: if isAdmin() && keepsRatingFields();
      allow delete: if isAdmin();
    }
    match /restaurants/{docId} {
      allow read: if true;
      allow create: if isAdmin() && createsNoRatingFields();
      allow update: if isAdmin() && keepsRatingFields();
      allow delete: if isAdmin();
    }
    match /service_providers/{docId} {
      allow read: if true;
      allow create: if isAdmin() && createsNoRatingFields();
      allow update: if isAdmin() && keepsRatingFields();
      allow delete: if isAdmin();
    }
    match /attractions/{docId} {
      allow read: if true;
      allow create: if isAdmin() && createsNoRatingFields();
      allow update: if isAdmin() && keepsRatingFields();
      allow delete: if isAdmin();
    }

    match /accommodations_submissions/{docId} {
      allow read, write: if isAdmin() || (isSignedIn() && (resource.data.submittedBy == request.auth.uid || request.resource.data.submittedBy == request.auth.uid));
    }
    match /restaurants_submissions/{docId} {
      allow read, write: if isAdmin() || (isSignedIn() && (resource.data.submittedBy == request.auth.uid || request.resource.data.submittedBy == request.auth.uid));
    }
    match /service_providers_submissions/{docId} {
      allow read, write: if isAdmin() || (isSignedIn() && (resource.data.submittedBy == request.auth.uid || request.resource.data.submittedBy == request.auth.uid));
    }
    match /attractions_submissions/{docId} {
      allow read, write: if isAdmin() || (isSignedIn() && (resource.data.submittedBy == request.auth.uid || request.resource.data.submittedBy == request.auth.uid));
    }
  }
}
